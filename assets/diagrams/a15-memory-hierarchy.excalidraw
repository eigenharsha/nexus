  {
   "id": "a15-memory-hierarchy-n1",
   "type": "text",
   "x": 60.0,
   "y": 465.0,
   "width": 1653.43,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 268201981,
   "version": 1,
   "versionNonce": 1346511138,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "L1 to DRAM is 80x. DRAM to SSD is another 1000x. Your algorithm does not get to ignore this: a cache-friendly O(n²) beats a pointer-chasing O(n log n) more often than anyone admits.",
   "originalText": "L1 to DRAM is 80x. DRAM to SSD is another 1000x. Your algorithm does not get to ignore this: a cache-friendly O(n²) beats a pointer-chasing O(n log n) more often than anyone admits.",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "a15-memory-hierarchy-n2",
   "type": "text",
   "x": 640.0,
   "y": 455.0,
   "width": 895.23,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 27685203,
   "version": 1,
   "versionNonce": 1737986753,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "this is the whole reason B-trees exist (week 8), and the whole reason a KV cache exists (week 25).",
   "originalText": "this is the whole reason B-trees exist (week 8), and the whole reason a KV cache exists (week 25).",

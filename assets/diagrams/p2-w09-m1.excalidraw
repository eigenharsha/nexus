   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "De Morgan: a OR b = NOT(NOT a AND NOT b). Push the bubbles through the gate and the OR falls out. That is the whole trick.",
   "originalText": "De Morgan: a OR b = NOT(NOT a AND NOT b). Push the bubbles through the gate and the OR falls out. That is the whole trick.",

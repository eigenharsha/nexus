   "text": "their history diverges and the next pull merges the same work twice",
   "originalText": "their history diverges and the next pull merges the same work twice",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "a05-git-dag-n1",
   "type": "text",
   "x": 80.0,
   "y": 455.0,
   "width": 1562.08,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 10527779,
   "version": 1,
   "versionNonce": 277325939,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "a commit is a SNAPSHOT plus parents, not a diff. Once you believe that, merge and rebase stop being scary: one adds a node, the other builds new nodes and moves the label.",
   "originalText": "a commit is a SNAPSHOT plus parents, not a diff. Once you believe that, merge and rebase stop being scary: one adds a node, the other builds new nodes and moves the label.",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "a05-git-dag-n2",
   "type": "text",
   "x": 640.0,
   "y": 505.0,
   "width": 1041.39,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47653517,
   "version": 1,
   "versionNonce": 1887295376,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the reflog remembers the old SHAs for ~90 days. It is the closest thing git has to an undo, and nobody teaches it.",
   "originalText": "the reflog remembers the old SHAs for ~90 days. It is the closest thing git has to an undo, and nobody teaches it.",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

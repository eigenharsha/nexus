   "versionNonce": 185906648,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the bug everyone writes: while lo < hi vs lo <= hi, and mid = (lo+hi)//2 overflowing in languages with fixed ints. Write the invariant in a comment and the off-by-one dies.",
   "originalText": "the bug everyone writes: while lo < hi vs lo <= hi, and mid = (lo+hi)//2 overflowing in languages with fixed ints. Write the invariant in a comment and the off-by-one dies.",

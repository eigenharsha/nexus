# Copy to .github/workflows/ci.yml in YOUR repo (this file is named so it does not
# run inside the course repo).
#
# TODO (standard): build the image, run the tests INSIDE it, push on a tag.
# Running tests inside the image is the point — tests that pass on the runner and
# fail in the container are the single most common CI/CD lie.
name: ci
on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - name: Build
        run: docker build -t prediction-service:${{ github.sha }} .
      - name: Image size budget
        run: |
          size=$(docker image inspect prediction-service:${{ github.sha }} --format '{{.Size}}')
          echo "image size: $((size / 1024 / 1024)) MB"
          test "$size" -lt 629145600   # 600 MB
      - name: Test inside the image
        run: docker run --rm -v "$PWD/tests:/app/tests" prediction-service:${{ github.sha }} python -m pytest /app/tests -q
      # TODO: push to a registry on a tag, then deploy.

# Convenience targets for the kind cluster. `make -f Makefile.kind up`
.PHONY: up load deploy load-test down

up:
	kind create cluster --name nexus --config kind-cluster.yaml
	kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/kind/deploy.yaml
	kubectl -n ingress-nginx wait --for=condition=ready pod -l app.kubernetes.io/component=controller --timeout=180s

load:
	kind load docker-image prediction-service:latest --name nexus

deploy:
	kubectl apply -f manifests/base/
	kubectl rollout status deployment/prediction-service --timeout=180s

load-test:
	@echo "TODO: point your load generator at http://localhost:8080 and record"
	@echo "p50/p95/p99 at three load levels, plus the pod count over time."

down:
	kind delete cluster --name nexus

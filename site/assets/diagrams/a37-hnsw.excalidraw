   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the top layer is the motorway: few nodes, huge jumps. Layer 0 is the last mile. Same trick as a skip list.",
   "originalText": "the top layer is the motorway: few nodes, huge jumps. Layer 0 is the last mile. Same trick as a skip list.",

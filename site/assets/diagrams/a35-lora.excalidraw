   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "you are not compressing the model. You are betting the UPDATE is low-rank. For instruction tuning that bet pays. For teaching it a new language it does not.",
   "originalText": "you are not compressing the model. You are betting the UPDATE is low-rank. For instruction tuning that bet pays. For teaching it a new language it does not.",

   "version": 1,
   "versionNonce": 599045835,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Big-O throws the constant away. Your laptop does not. At n = 1000 all three fit in L2 and the difference vanishes entirely.",
   "originalText": "Big-O throws the constant away. Your laptop does not. At n = 1000 all three fit in L2 and the difference vanishes entirely.",

  {
   "id": "a28-backprop-n1",
   "type": "text",
   "x": 48.0,
   "y": 525.0,
   "width": 1790.46,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 45428441,
   "version": 1,
   "versionNonce": 1832879478,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the backward pass costs ~2x the forward pass and reuses every value the forward pass computed. That is why activations sit in memory, and why batch size is the first thing that blows up your VRAM.",
   "originalText": "the backward pass costs ~2x the forward pass and reuses every value the forward pass computed. That is why activations sit in memory, and why batch size is the first thing that blows up your VRAM.",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "a28-backprop-n2",
   "type": "text",
   "x": 700.0,
   "y": 525.0,
   "width": 1087.06,
   "height": 18.75,
   "angle": -0.04363323129985824,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 216778871,
   "version": 1,
   "versionNonce": 1794776725,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ReLU's gradient is 1 or 0. Nothing in between. When it is 0 that unit learns NOTHING this step - the dead-ReLU problem.",
   "originalText": "ReLU's gradient is 1 or 0. Nothing in between. When it is 0 that unit learns NOTHING this step - the dead-ReLU problem.",
   "fontSize": 15.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

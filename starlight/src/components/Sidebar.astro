---
/* Mintlify's left rail shows only the section chosen in the top nav; Starlight
   renders the whole tree, so every phase sat collapsed above the week you were
   actually reading. Filter the sidebar to the top-level group containing the
   current page, and let the header row handle moving between sections.

   Falls back to the full tree if nothing matches, so a page outside the
   sidebar (a 404, say) still navigates. */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

function holdsCurrent(items: any[]): boolean {
  return (items ?? []).some((i: any) =>
    (i.type === 'link' && i.isCurrent) ||
    (i.type === 'group' && holdsCurrent(i.entries))
  );
}

const section = sidebar.find((i: any) => i.type === 'group' && holdsCurrent(i.entries));
const shown = section ? section.entries : sidebar;
---

<SidebarPersister>
  {section && <p class="section-label">{section.label}</p>}
  <SidebarSublist sublist={shown} />
</SidebarPersister>

<style>
  .section-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    padding: 0 0 0.5rem 1rem;
    margin: 0 0 0.25rem;
    opacity: 0.75;
  }
</style>

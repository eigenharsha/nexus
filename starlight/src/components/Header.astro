---
/* Mintlify puts the phase sections in a second header row; Starlight is
   sidebar-only by default. Wrap the stock header and add that row, so the
   top-level structure reads the same and the sidebar is free to show the
   week's own modules. */
import Default from '@astrojs/starlight/components/Header.astro';

const phases = [
  { label: 'Start here',              href: '/' },
  { label: 'Phase 1 · Foundations',   href: '/curriculum/p1/week-01/' },
  { label: 'Phase 2 · Systems & Data',href: '/curriculum/p2/week-09/' },
  { label: 'Phase 3 · Machine Learning', href: '/curriculum/p3/week-17/' },
  { label: 'Phase 4 · Generative AI', href: '/curriculum/p4/week-25/' },
  { label: 'Labs',                    href: '/labs/' },
  { label: 'Projects',                href: '/projects/midterm/' },
  { label: 'Reference',               href: '/reference/papers/' },
];

const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.slice(0, 15));
---

<div class="nexus-header">
  <Default><slot /></Default>
  <nav class="phase-nav" aria-label="Course sections">
    {phases.map((p) => (
      <a href={p.href} class:list={['phase-link', { active: active(p.href) }]}>
        {p.label}
      </a>
    ))}
  </nav>
</div>

<style>
  /* Starlight's header is position:fixed with height var(--sl-nav-height).
     The override renders inside that box, so the wrapper has to stack the two
     rows and fill it - otherwise the nav row paints over the sidebar. */
  .nexus-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .nexus-header > :global(.header) {
    position: static !important;
    height: 64px !important;
    border-bottom: 1px solid var(--sl-color-hairline);
    inset: auto !important;
    width: 100%;
  }

  .phase-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    height: 48px;
    flex: 0 0 48px;
    padding-inline: 2rem;
    background: var(--sl-color-bg-nav);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .phase-nav::-webkit-scrollbar { display: none; }
  .phase-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
  }
  .phase-link:hover { color: var(--sl-color-white); }
  .phase-link.active {
    color: var(--sl-color-white);
    border-bottom-color: var(--sl-color-text-accent);
  }
</style>

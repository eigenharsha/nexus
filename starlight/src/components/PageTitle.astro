---
/* Mintlify prints a blue breadcrumb naming the week above the h1, then the
   title, then the description as a subtitle. Starlight renders the title only.

   Starlight 0.42 passes route data on Astro.locals.starlightRoute, not as
   component props - reading Astro.props.entry gives undefined and fails the
   build several hundred pages in. */
// '@astrojs/starlight/constants' is not a public export; the id is stable
const PAGE_TITLE_ID = '_top';

const route = Astro.locals.starlightRoute;
const { entry, sidebar } = route;

function findGroup(items: any[]): string | null {
  for (const item of items ?? []) {
    if (item.type === 'group') {
      if (item.entries?.some((e: any) => e.type === 'link' && e.isCurrent))
        return item.label;
      const hit = findGroup(item.entries);
      if (hit) return hit;
    }
  }
  return null;
}
const crumb = findGroup(sidebar);
---

{crumb && <p class="nexus-crumb">{crumb}</p>}
<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
{entry.data.description && <p class="page-subtitle">{entry.data.description}</p>}

<style>
  .nexus-crumb {
    font-size: 14px;
    font-weight: 500;
    color: var(--sl-color-text-accent);
    margin: 0 0 0.35rem;
  }
  h1 {
    font-size: 36px;
    line-height: 40px;
    letter-spacing: -0.9px;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.5rem;
  }
  .page-subtitle {
    font-size: 18px;
    line-height: 28px;
    color: var(--sl-color-gray-3);
    margin: 0 0 1.5rem;
  }
</style>
